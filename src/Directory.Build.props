<Project>
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
		<Authors>Adolfok3</Authors>
		<Copyright>MIT</Copyright>
		<PackageProjectUrl>https://github.com/Adolfok3/authorizationinterceptor</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/Adolfok3/authorizationinterceptor</RepositoryUrl>
		<Description>A simple and lightweight .NET package designed to streamline HttpClient authenticated requests</Description>		<PackageTags>dotnet;c#;.net;core;authorization;authentication;interceptor;httpclient;rest;api;auth;headers;cache;memory;distributed;refit;request;response;anauthoriezed;</PackageTags>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />
		<PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
		<PackageReference Include="Roslynator.CodeAnalysis.Analyzers" PrivateAssets="all" />
		<PackageReference Include="Roslynator.Formatting.Analyzers" PrivateAssets="all" />
		<PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
		<PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
		<PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
	</ItemGroup>
  
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AuthorizationInterceptor.Extensions.MemoryCache' Or '$(MSBuildProjectName)' == 'AuthorizationInterceptor.Extensions.DistributedCache'">
    <IsCachingAbstractionsTargeted>true</IsCachingAbstractionsTargeted>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AuthorizationInterceptor'">
    <IsMainPackage>true</IsMainPackage>
  </PropertyGroup>
  
  <ItemGroup>
		<None Include="../../resources/icon.png" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(IsMainPackage)' == 'true'">
    <None Include="../../README.md" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(IsMainPackage)' != 'true'">
    <None Include="./README.md" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(IsCachingAbstractionsTargeted)' == 'true'">
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
  </ItemGroup>
  </Project>
